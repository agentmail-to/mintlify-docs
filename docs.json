{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "AgentMail",
  "colors": {
    "primary": "#18181b",
    "light": "#fafafa",
    "dark": "#09090b"
  },
  "appearance": {
    "default": "dark"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Home",
        "pages": [
          "index"
        ]
      },
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Start here",
            "pages": [
              "introduction",
              "quickstart",
              "architecture"
            ]
          },
          {
            "group": "Core tasks",
            "pages": [
              "tasks/receive",
              "tasks/send",
              "tasks/conversations",
              "tasks/inbound-control"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@agentmail.cc"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get API Key",
      "href": "https://console.agentmail.to"
    }
  },
  "markdown": {
    "instructions": "Every page ships two renditions at one URL. The HTML page is for humans. The Markdown rendition (append .md to any page URL, or request with Accept: text/markdown) is agent-optimized: a Do this section with runnable commands, SDK signatures, exhaustive Facts, a Not supported section listing shapes that do NOT work, an Errors table, and a Verify command. Prefer the Markdown rendition over scraping HTML, and trust Not supported entries instead of retrying those call shapes."
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/agentmail_to",
      "github": "https://github.com/agentmail-to",
      "discord": "https://discord.gg/hTYatWYWBc"
    }
  }
}
